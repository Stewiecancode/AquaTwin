# Local, loopback-only demo. Set false for production (Firebase required).
DEMO_MODE=true
STORAGE_DRIVER=file
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
MUNICIPALITY_ID=demo-mahikeng
# For Firestore: STORAGE_DRIVER=firestore and use Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=
# Browser Firebase config is public; never put Admin keys in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Production frontend: backend HTTPS origin (no /api suffix)
VITE_API_URL=
# Device telemetry, production only: strong secret, store only on server/device.
DEVICE_API_KEY=
# Manually started township controller, reachable from the AquaTwin backend.
TWIN_CONTROLLER_URL=http://127.0.0.1:8765
